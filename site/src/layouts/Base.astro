---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { PUBLIC_ORIGIN } from "../lib/site";
import { ANALYSES } from "../lib/analyses";
import type { IconName } from "../lib/icons";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, PUBLIC_ORIGIN).href;
const imageUrl = new URL("/share.png", PUBLIC_ORIGIN).href;
const fullTitle = title === "Chaque Euro" ? title : `${title} · Chaque Euro`;
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
interface NavItem {
  href: string;
  label: string;
  icon: IconName;
}
const groups: { title: string; items: NavItem[] }[] = [
  {
    title: "Où va l’argent ?",
    items: [
      { href: "/", label: "Accueil", icon: "home" },
      { href: "/argent-public", label: "Tout l'argent public", icon: "euro" },
      { href: "/budget-etat", label: "Budget de l'État", icon: "state" },
      {
        href: "/argent-public/securite-sociale",
        label: "Sécurité sociale",
        icon: "socialSecurity",
      },
      { href: "/analyses", label: "Analyses", icon: "analysis" },
    ],
  },
  {
    title: "Près de vous",
    items: [
      { href: "/communes", label: "Communes", icon: "town" },
      { href: "/regions", label: "Régions", icon: "region" },
    ],
  },
  {
    title: "Qui reçoit l’argent ?",
    items: [
      { href: "/organisations", label: "Organisations", icon: "building" },
      { href: "/marches-publics", label: "Marchés publics", icon: "contract" },
    ],
  },
  {
    title: "Vos représentants",
    items: [{ href: "/elus", label: "Élus", icon: "elected" }],
  },
  {
    title: "Avec une IA",
    items: [{ href: "/ia", label: "MCP", icon: "assistant" }],
  },
];
const secondary: NavItem[] = [
  { href: "/argent-public/operateurs", label: "Opérateurs de l'État", icon: "building" },
  { href: "/argent-public/collectivites", label: "Collectivités locales", icon: "town" },
  { href: "/intercommunalites", label: "Intercommunalités", icon: "intercommunalite" },
  { href: "/votes", label: "Votes", icon: "vote" },
  { href: "/campagnes", label: "Campagnes", icon: "campaign" },
  { href: "/alertes", label: "Alertes", icon: "alert" },
  { href: "/train-de-vie", label: "Moyens publics", icon: "spending" },
  { href: "/lobbying", label: "Lobbying", icon: "lobbying" },
  { href: "/financement-politique", label: "Financement politique", icon: "politicalFinance" },
  { href: "/journal-officiel", label: "Journal officiel", icon: "journal" },
  { href: "/documents/dossiers", label: "Dossiers législatifs", icon: "legislation" },
  { href: "/administrations", label: "Administrations", icon: "administration" },
  ...ANALYSES.map((article) => ({
    href: `/analyses/${article.slug}`,
    label: article.short,
    icon: article.icon,
  })),
  { href: "/lexique", label: "Lexique", icon: "book" },
  { href: "/methodologie", label: "Méthode et sources", icon: "method" },
  { href: "/telechargements", label: "Télécharger les données", icon: "download" },
];
const exact = new Set(["/", "/analyses"]);
const current = (href: string) =>
  path === href ||
  (!exact.has(href) && href !== "/argent-public" && path.startsWith(`${href}/`)) ||
  (href === "/argent-public" && path === "/argent-public/etat") ||
  (href === "/organisations" && path.startsWith("/organisation/")) ||
  (href === "/communes" && (path.startsWith("/commune/") || path.startsWith("/departement/")))
    ? "page"
    : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Chaque Euro" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Chaque Euro. Votre commune, l’État, vos élus : des chiffres sourcés."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#contenu">
      Aller au contenu
    </a>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Chaque Euro, accueil">
        <img class="mark" src="/logo.svg" alt="" width="40" height="40" />
        <span class="wordmark">
          <span class="name">Chaque Euro</span>
          <span class="tagline">L'argent public, expliqué</span>
        </span>
      </a>
      <a class="icon-button" href="/recherche" aria-label="Rechercher">
        <Icon name="search" size={20} />
      </a>
      <button
        class="menu-button"
        type="button"
        popovertarget="navigation"
        aria-label="Ouvrir le menu"
      >
        <span class="burger" aria-hidden="true"></span>
      </button>
    </header>
    <div class="shell">
      <aside class="sidebar" id="navigation" popover>
        <div class="sidebar-head">
          <a class="brand" href="/" aria-label="Chaque Euro, accueil">
            <img class="mark" src="/logo.svg" alt="" width="40" height="40" />
            <span class="wordmark">
              <span class="name">Chaque Euro</span>
              <span class="tagline">L'argent public, expliqué</span>
            </span>
          </a>
          <button
            class="close"
            type="button"
            popovertarget="navigation"
            popovertargetaction="hide"
            aria-label="Fermer le menu"
          >
            <Icon name="close" size={20} />
          </button>
        </div>
        <a class="search" href="/recherche" aria-current={current("/recherche")}>
          <Icon name="search" size={17} />
          Rechercher
        </a>
        <nav aria-label="Navigation principale">
          {groups.map((group) => (
            <div class="group">
              <p class="group-title">{group.title}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href} aria-current={current(item.href)}>
                      <Icon name={item.icon} size={17} />
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <details class="group secondary" open={secondary.some((item) => current(item.href))}>
            <summary>
              <Icon name="list" size={17} />
              Tout le site
            </summary>
            <ul>
              {secondary.map((item) => (
                <li>
                  <a href={item.href} aria-current={current(item.href)}>
                    <Icon name={item.icon} size={17} />
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </aside>
      <div class="page">
        <main id="contenu">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="container cols">
            <div>
              <p class="footer-brand">Chaque Euro</p>
              <p>
                Site indépendant de l'État. Chaque chiffre renvoie à sa source officielle et à son
                calcul.
              </p>
            </div>
            <nav aria-label="Données">
              <p class="footer-title">Données</p>
              <ul>
                <li>
                  <a href="/methodologie#sources">
                    <Icon name="info" size={16} />
                    Limites connues
                  </a>
                </li>
                <li>
                  <a href="/methodologie/manifest.json">
                    <Icon name="source" size={16} />
                    Manifeste des fichiers
                  </a>
                </li>
                <li>
                  <a href="/telechargements">
                    <Icon name="download" size={16} />
                    Télécharger les données
                  </a>
                </li>
                <li>
                  <a href="/ia">
                    <Icon name="assistant" size={16} />
                    MCP pour les assistants IA
                  </a>
                </li>
                <li>
                  <a href="/contact">
                    <Icon name="mail" size={16} />
                    Contact
                  </a>
                </li>
                <li>
                  <a href="/mentions-legales">
                    <Icon name="privacy" size={16} />
                    Mentions légales et correction
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: #fff;
    padding: 0.5rem 0.75rem;
    z-index: 20;
  }

  .skip:focus {
    left: 0.5rem;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.5rem;
    padding: 0 1.25rem;
    background: rgb(255 255 255 / 94%);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .topbar .brand {
    margin-right: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    color: var(--navy-900);
    text-decoration: none;
  }

  .mark {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .name {
    font-weight: 750;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .icon-button,
  .menu-button,
  .close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .icon-button,
  .menu-button {
    padding: 0;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 1px;
    transition:
      transform 0.28s ease,
      top 0.28s ease,
      background-color 0.2s ease;
  }

  .burger {
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -5px;
  }

  .burger::after {
    top: 5px;
  }

  :global(body:has(.sidebar:popover-open)) .burger {
    background-color: transparent;
  }

  :global(body:has(.sidebar:popover-open)) .burger::before {
    top: 0;
    transform: rotate(45deg);
  }

  :global(body:has(.sidebar:popover-open)) .burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    flex-direction: column;
    width: min(19rem, 88vw);
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem 0.875rem 2rem;
    border: 0;
    border-right: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    overflow-y: auto;
    box-shadow: 0 24px 48px rgb(7 22 49 / 22%);
    transform: translateX(-100%);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  .sidebar:popover-open {
    display: flex;
    transform: translateX(0);
  }

  @starting-style {
    .sidebar:popover-open {
      transform: translateX(-100%);
    }
  }

  .sidebar::backdrop {
    background-color: rgb(7 22 49 / 0%);
    transition:
      background-color 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  .sidebar:popover-open::backdrop {
    background-color: rgb(7 22 49 / 45%);
  }

  @starting-style {
    .sidebar:popover-open::backdrop {
      background-color: rgb(7 22 49 / 0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .sidebar::backdrop,
    .burger,
    .burger::before,
    .burger::after {
      transition: none;
    }
  }

  .sidebar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0.25rem;
  }

  .close {
    padding: 0;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0.25rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .search:hover,
  .search[aria-current="page"] {
    border-color: var(--link);
    color: var(--navy-900);
  }

  .group-title {
    margin: 1.375rem 0.75rem 0.375rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .secondary {
    margin-top: 1.375rem;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }

  .secondary summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .secondary summary::-webkit-details-marker {
    display: none;
  }

  .secondary summary::after {
    content: "+";
    margin-left: auto;
  }

  .secondary[open] summary::after {
    content: "−";
  }

  .group ul {
    display: grid;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.75rem;
    border-radius: 9px;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.3;
    text-decoration: none;
  }

  .group a :global(svg) {
    flex: none;
    color: var(--text-muted);
  }

  .group a:hover {
    background: var(--navy-50);
    color: var(--navy-900);
  }

  .group a[aria-current="page"] {
    background: var(--navy-900);
    color: #fff;
    font-weight: 650;
  }

  .group a[aria-current="page"] :global(svg) {
    color: #fff;
  }

  .page {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: calc(100vh - 3.5rem);
  }

  @media (min-width: 72rem) {
    .topbar {
      display: none;
    }

    .shell {
      display: grid;
      grid-template-columns: 16.5rem minmax(0, 1fr);
      background: linear-gradient(
        90deg,
        var(--surface-alt) calc(16.5rem - 1px),
        var(--border) calc(16.5rem - 1px) 16.5rem,
        transparent 16.5rem
      );
    }

    .sidebar,
    .sidebar:popover-open {
      position: sticky;
      z-index: 5;
      inset: auto;
      top: 0;
      display: flex;
      flex-direction: column;
      width: auto;
      height: 100vh;
      max-height: none;
      margin: 0;
      padding: 1.5rem 1rem 2rem;
      border: 0;
      border-right: 1px solid var(--border);
      background: var(--surface-alt);
      color: var(--text);
      overflow-y: auto;
      box-shadow: none;
      scrollbar-width: thin;
      transform: none;
      transition: none;
    }

    .close {
      display: none;
    }

    .group a {
      min-height: 0;
    }

    .page {
      min-height: 100vh;
    }
  }

  .site-footer {
    margin-top: 2.5rem;
    background: var(--navy-950);
    color: #c8d3ea;
    padding: 2.5rem 0 3rem;
    font-size: 0.9375rem;
  }

  .cols {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 48rem) {
    .site-footer {
      margin-top: 4rem;
    }

    .cols {
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
    }
  }

  .site-footer p {
    max-width: 30rem;
  }

  .footer-brand {
    font-weight: 750;
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .footer-title {
    font-weight: 650;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #e3e9f6;
  }
</style>
