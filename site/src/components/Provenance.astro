---
import type { Provenance } from "../lib/data";
import { formatDate } from "../lib/format";
import Icon from "./Icon.astro";

interface Props {
  provenance: Provenance | Provenance[];
  labels?: string[];
}

const { labels = [] } = Astro.props;
const entries = [Astro.props.provenance].flat();
const dates = [
  ...new Set(
    entries.flatMap(({ citations }) => citations.map(({ source }) => source.dataDate ?? "")),
  ),
];
const summaryDate = dates.length === 1 && dates[0] ? formatDate(dates[0]) : null;
---

<footer class="provenance">
  <details>
    <summary>
      <Icon name="source" size={16} />
      Sources
      {summaryDate && <span class="summary-date">données au {summaryDate}</span>}
      <span class="chevron">
        <Icon name="expand" size={16} />
      </span>
    </summary>
    <div class="panel">
      {Astro.slots.has("default") && (
        <div class="note">
          <slot />
        </div>
      )}
      {entries.map((provenance, index) => (
        <section class="entry">
          {labels[index] && <p class="entry-label">{labels[index]}</p>}
          <ul class="sources">
            {provenance.citations.map(({ source, recordUrl }) => {
              const href = recordUrl ?? source.fileUrl ?? source.pageUrl;
              return (
                <li class="source">
                  <div class="source-text">
                    <p class="source-tag">
                      <strong>{source.shortName}</strong>
                      {source.dataDate && <span>données au {formatDate(source.dataDate)}</span>}
                    </p>
                    <a class="source-name" href={source.pageUrl}>
                      {source.name}
                    </a>
                    <p class="meta">
                      <span>{source.publisher}</span>
                      {source.coverage && <span>{source.coverage}</span>}
                      {source.publishedAt && (
                        <span>Mis à jour le {formatDate(source.publishedAt)}</span>
                      )}
                      {source.retrievedAt && (
                        <span>Récupéré le {formatDate(source.retrievedAt)}</span>
                      )}
                      {source.fileUrl && source.fileUrl !== href && (
                        <a href={source.fileUrl}>Fichier source</a>
                      )}
                      <a href={source.licence.url}>{source.licence.name}</a>
                    </p>
                  </div>
                  <a class="action" href={href}>
                    <Icon name="external" size={14} />
                    Voir la source
                  </a>
                </li>
              );
            })}
          </ul>
          <div class="calc">
            <p>{provenance.method}</p>
            <a class="action" href={provenance.calculationUrl}>
              <Icon name="code" size={14} />
              Voir le calcul
            </a>
          </div>
        </section>
      ))}
      <a class="all" href="/methodologie#sources">
        Toutes les sources et leurs limites
      </a>
    </div>
  </details>
</footer>

<style>
  .provenance {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: 100%;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--link);
    font-size: 0.8125rem;
    font-weight: 650;
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
  }

  summary:hover {
    border-color: var(--link);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible,
  .action:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .summary-date {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-muted);
    font-weight: 400;
  }

  .summary-date::before {
    content: "· ";
  }

  .chevron {
    display: inline-flex;
    transition: transform 0.15s ease;
  }

  [open] > summary .chevron {
    transform: rotate(180deg);
  }

  .panel {
    display: grid;
    gap: 0.875rem;
    margin-top: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--navy-50);
    line-height: 1.5;
  }

  .note :global(p),
  .note :global(ul) {
    margin: 0 0 0.5rem;
  }

  .note :global(ul) {
    padding-left: 1.25rem;
  }

  .entry {
    display: grid;
    gap: 0.5rem;
  }

  .entry + .entry {
    padding-top: 0.875rem;
    border-top: 1px solid var(--border);
  }

  .entry-label {
    margin: 0;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .sources {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }

  .source-text {
    flex: 1 1 15rem;
    min-width: 0;
  }

  .source-tag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    font-size: 0.75rem;
  }

  .source-tag strong {
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: var(--navy-100);
    color: var(--navy-900);
    font-weight: 650;
  }

  .source-name {
    display: block;
    margin-top: 0.375rem;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .source-name:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .meta {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .meta > :not(:first-child)::before {
    content: "·";
    display: inline-block;
    margin: 0 0.4em;
    color: var(--text-muted);
  }

  .action {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--link);
    font-size: 0.8125rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .action:hover {
    border-color: var(--link);
  }

  .calc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .calc p {
    flex: 1 1 15rem;
    margin: 0;
    font-size: 0.8125rem;
  }

  .all {
    justify-self: start;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media (pointer: coarse) {
    summary,
    .action {
      min-height: 44px;
    }
  }
</style>
