---
import type { Provenance } from "../lib/data";
import { formatDate } from "../lib/format";
import Icon from "./Icon.astro";

interface Props {
  provenance: Provenance;
}

const { provenance } = Astro.props;
const shortNames = provenance.citations.map(({ source }) => source.shortName);
const names = [...new Set(shortNames)].join(", ");
const ambiguous = new Set(shortNames).size < shortNames.length;
const tag = (source: Provenance["citations"][number]["source"]) =>
  ambiguous ? (source.name.split(/ : | \(/)[0] ?? source.name) : source.shortName;
---

<footer class="provenance">
  <div class="line">
    <span class="label">
      <Icon name="source" size={16} />
      Source : {names}
    </span>
    {provenance.citations
      .filter(({ source }) => source.dataDate)
      .map(({ source }) => (
        <span class="data-date">
          {provenance.citations.length > 1 && `${tag(source)} : `}
          données au {formatDate(source.dataDate!)}
        </span>
      ))}
    {provenance.citations.map(({ source, recordUrl }) => (
      <a href={recordUrl ?? source.fileUrl ?? source.pageUrl}>
        <Icon name="external" size={14} />
        Voir la source
        {provenance.citations.length > 1 && <span class="muted"> ({tag(source)})</span>}
      </a>
    ))}
    <a href={provenance.calculationUrl}>
      <Icon name="code" size={14} />
      Voir le calcul
    </a>
    <details>
      <summary>
        <Icon name="info" size={14} />
        Méthode
      </summary>
      <p>{provenance.method}</p>
      <ul>
        {provenance.citations.map(({ source }) => (
          <li>
            <a href={source.pageUrl}>{source.name}</a>, {source.publisher}.{" "}
            {source.fileUrl && (
              <>
                <a href={source.fileUrl}>Fichier source</a>.{" "}
              </>
            )}
            {source.coverage && <>{source.coverage}. </>}
            {source.publishedAt && <>Fichier mis à jour le {formatDate(source.publishedAt)}. </>}
            {source.retrievedAt && <>Récupéré le {formatDate(source.retrievedAt)}. </>}
            <a href={source.licence.url}>{source.licence.name}</a>.
          </li>
        ))}
      </ul>
      <p>
        <a href="/methodologie#sources">Toutes les sources et leurs limites</a>
      </p>
    </details>
  </div>
</footer>

<style>
  .provenance {
    margin-top: 1.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-right: 0.25rem;
    font-weight: 550;
  }

  .line > a {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    line-height: 1.4;
    background: var(--surface);
    color: var(--link);
    font-size: 0.8125rem;
    font-weight: 650;
    text-decoration: none;
  }

  .line > a :global(svg) {
    margin-right: 0.3rem;
    vertical-align: -0.15em;
  }

  .line > a:hover {
    border-color: var(--link);
    background: var(--navy-50);
  }

  details[open] {
    flex-basis: 100%;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.25rem;
    color: var(--link);
    font-weight: 600;
    width: fit-content;
    cursor: pointer;
  }

  details p,
  details ul {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  details ul {
    padding-left: 1.25rem;
  }
</style>
