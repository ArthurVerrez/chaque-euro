---
import type { IconName } from "../lib/icons";
import Icon from "./Icon.astro";

interface Props {
  items: { href: string; label: string; icon: IconName }[];
  article?: boolean;
}

const { items, article = false } = Astro.props;
const Panel = article ? "details" : "div";
---

<nav class:list={["toc", { "article-toc": article }]} aria-label="Sur cette page">
  <Panel class:list={{ container: !article }}>
    {article && (
      <summary>
        <Icon name="list" size={16} /> Sommaire{" "}
        <span>
          <Icon name="expand" size={16} />
        </span>
      </summary>
    )}
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href}>
            <Icon name={item.icon} size={15} />
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </Panel>
</nav>

<script>
  const list = document.querySelector<HTMLUListElement>(".toc ul");
  const disclosure = document.querySelector<HTMLDetailsElement>(".article-toc > details");
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  if (disclosure) {
    const wide = matchMedia("(min-width: 60rem)");
    const reset = () => {
      disclosure.open = wide.matches;
    };
    reset();
    wide.addEventListener("change", reset);
    for (const link of links) {
      link.addEventListener("click", () => {
        if (!wide.matches) disclosure.open = false;
      });
    }
  }
  const sections = links.flatMap((link) => {
    const target = document.querySelector(link.hash);
    return target ? [{ link, target }] : [];
  });
  const update = () => {
    const line = window.innerHeight * 0.3;
    const current = sections
      .filter(({ target }) => target.getBoundingClientRect().top < line)
      .at(-1);
    if (current && !current.link.hasAttribute("aria-current") && list && !disclosure) {
      const left = current.link.offsetLeft - (list.clientWidth - current.link.offsetWidth) / 2;
      list.scrollTo({ left, behavior: "smooth" });
    }
    for (const { link } of sections) {
      if (link === current?.link) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };
  const fade = () => {
    if (!list || disclosure) return;
    list.classList.toggle("more-start", list.scrollLeft > 1);
    list.classList.toggle("more-end", list.scrollLeft + list.clientWidth < list.scrollWidth - 1);
  };
  addEventListener("scroll", update, { passive: true });
  list?.addEventListener("scroll", fade, { passive: true });
  addEventListener("resize", fade);
  update();
  fade();
</script>

<style>
  .toc {
    position: sticky;
    top: var(--sticky-top);
    z-index: 5;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  ul {
    display: flex;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0.375rem 0;
    overflow-x: auto;
    scrollbar-width: none;
    --fade-start: 0rem;
    --fade-end: 0rem;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-start),
      #000 calc(100% - var(--fade-end)),
      transparent
    );
  }

  ul.more-start {
    --fade-start: 3rem;
  }

  ul.more-end {
    --fade-end: 3rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    white-space: nowrap;
    padding: 0 0.875rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
  }

  a:hover {
    background: var(--navy-50);
    color: var(--navy-900);
  }

  a[aria-current="true"] {
    background: var(--navy-900);
    color: #fff;
  }

  .article-toc {
    position: static;
    z-index: auto;
    align-self: start;
    min-width: 0;
    border-block: 1px solid var(--rule);
    background: transparent;
    backdrop-filter: none;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 650;
    font-size: 0.875rem;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    display: inline-flex;
    margin-left: auto;
  }

  [open] > summary span {
    transform: rotate(180deg);
  }

  .article-toc ul {
    display: grid;
    gap: 0;
    padding: 0 0 0.65rem;
    overflow: visible;
    mask-image: none;
  }

  .article-toc a {
    display: flex;
    min-height: 2.45rem;
    border-left: 2px solid var(--rule);
    border-radius: 0;
    padding: 0.3rem 0.65rem;
    color: var(--subtle);
    line-height: 1.3;
    font-weight: 450;
    font-size: 0.875rem;
    white-space: normal;
  }

  .article-toc a :global(svg) {
    flex: none;
  }

  .article-toc a[aria-current="true"],
  .article-toc a:hover {
    border-color: var(--red);
    background: transparent;
    color: var(--red);
  }

  @media (min-width: 60rem) {
    .article-toc {
      position: sticky;
      top: calc(var(--sticky-top) + 1.25rem);
      border-bottom: 0;
    }
  }

  @media (pointer: coarse) {
    .article-toc a {
      min-height: 44px;
    }
  }
</style>
