---
import Answer from "./Answer.astro";
import BarList from "./BarList.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import Icon from "./Icon.astro";
import KeyFigures from "./KeyFigures.astro";
import LocalLevelsExplainer from "./LocalLevelsExplainer.astro";
import Provenance from "./Provenance.astro";
import Toc from "./Toc.astro";
import { getLocalAccounts } from "../lib/data";
import { formatEuro, formatEuros, formatNumber } from "../lib/format";

interface Props {
  level: "region" | "epci";
}
const { level } = Astro.props;
const selected = Number(Astro.url.searchParams.get("annee") ?? 2025);
const year = Number.isInteger(selected) && selected >= 2018 && selected <= 2025 ? selected : 2025;
const query = (Astro.url.searchParams.get("q") ?? "").trim();
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const data = await getLocalAccounts(
  level,
  year,
  query,
  Number.isInteger(requestedPage) ? requestedPage : 1,
);
const title = level === "region" ? "Régions et collectivités uniques" : "Intercommunalités";
const href = (target: number) =>
  `?${new URLSearchParams({ annee: String(year), q: query, page: String(target) })}`;
const euros = (value: number | null) => (value === null ? "n.d." : formatEuros(value));
const perCapita = (value: number | null) => (value === null ? "n.d." : formatEuro(value));
---

<header class="page-head" id="en-bref">
  <div class="container">
    <Breadcrumbs items={[{ label: title }]} />
    <div class="entity">
      <Icon name={level === "region" ? "region" : "intercommunalite"} />
      <h1>{title}</h1>
    </div>
    <Answer text={`Dépenses, recettes et dette de chaque collectivité en ${year}.`} />
    <KeyFigures
      figures={[
        {
          icon: "administration",
          label: "Collectivités",
          value: formatNumber(data.total),
        },
        { icon: "calendar", label: "Exercice", value: String(year) },
      ]}
    />
    <Provenance provenance={data.provenance} />
  </div>
</header>
<Toc
  items={[
    { href: "#comptes", label: "Les comptes", icon: "list" },
    { href: "#comparaison", label: "Par habitant", icon: "compare" },
  ]}
/>
<div class="container">
  <section class="section" id="comptes" aria-labelledby="titre-comptes">
    <div class="section-head">
      <h2 id="titre-comptes">
        <Icon name="list" />
        Les comptes {year}
      </h2>
    </div>
    <form method="get" class="filters">
      <label>
        Exercice
        <select name="annee">
          {Array.from({ length: 8 }, (_, i) => 2025 - i).map((entry) => (
            <option value={entry} selected={entry === year}>
              {entry}
            </option>
          ))}
        </select>
      </label>
      <label>
        Nom ou SIREN
        <input name="q" type="search" value={query} />
      </label>
      <button type="submit" class="button">
        Afficher
      </button>
    </form>
    <div class="card accounts">
      <table>
        <thead>
          <tr>
            <th scope="col">Collectivité</th>
            <th scope="col" class="num">
              Dépenses
            </th>
            <th scope="col" class="num">
              Recettes
            </th>
            <th scope="col" class="num">
              Dette
            </th>
          </tr>
        </thead>
        <tbody>
          {data.accounts.map((row) => (
            <tr>
              <th scope="row">
                <a
                  href={
                    row.provenance.citations[0]?.recordUrl ??
                    row.provenance.citations[0]?.source.pageUrl
                  }
                >
                  {row.name}
                </a>
                <span class="detail muted">
                  {row.category === "CTU" || row.category === "MET69"
                    ? "Collectivité particulière · "
                    : row.category === "EPT"
                      ? "EPT · "
                      : ""}
                  {row.siren}
                </span>
              </th>
              <td class="num">
                {euros(row.spending)}
                <span class="detail muted">{perCapita(row.spendingPerCapita)} / hab.</span>
              </td>
              <td class="num">
                {euros(row.revenue)}
                <span class="detail muted">{perCapita(row.revenuePerCapita)} / hab.</span>
              </td>
              <td class="num">
                {euros(row.debt)}
                <span class="detail muted">{perCapita(row.debtPerCapita)} / hab.</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {!data.accounts.length && <p>Aucune collectivité ne correspond à votre recherche.</p>}
    </div>
    {data.pages > 1 && (
      <nav class="pagination" aria-label="Pages des intercommunalités">
        {data.page > 1 && <a href={href(data.page - 1)}>Précédente</a>}
        <span>
          Page {data.page} sur {data.pages}
        </span>
        {data.page < data.pages && <a href={href(data.page + 1)}>Suivante</a>}
      </nav>
    )}
    <Provenance provenance={data.provenance}>
      {level === "epci" && year === 2025 && (
        <p>L’OFGL signale quatre comptes 2025 indisponibles. Aucun montant n’est estimé.</p>
      )}
    </Provenance>
    <LocalLevelsExplainer />
  </section>
  <section class="section" id="comparaison" aria-labelledby="titre-comparaison">
    <div class="section-head">
      <h2 id="titre-comparaison">
        <Icon name="compare" />
        Dépenses par habitant
      </h2>
    </div>
    <div class="card">
      <BarList
        caption={`Les plus élevées en ${year}, hors remboursement de dette`}
        items={data.highestSpendingPerCapita.map((row) => ({
          label: row.name,
          value: row.spendingPerCapita ?? 0,
          display: perCapita(row.spendingPerCapita),
          note: row.category === "CTU" ? "Compétences particulières" : undefined,
        }))}
      />
    </div>
    <Provenance provenance={data.provenance}>
      <p>Un montant élevé ne dit rien de la qualité de la gestion.</p>
    </Provenance>
  </section>
</div>

<style>
  .accounts {
    min-width: 0;
  }
  table {
    table-layout: fixed;
    width: 100%;
  }
  th:first-child {
    width: 40%;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .detail {
    display: block;
    font-size: 0.75rem;
    margin-top: 0.4rem;
    font-weight: 400;
    white-space: normal;
  }
  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (max-width: 40rem) {
    .accounts {
      padding: 0.5rem;
    }
    th:first-child {
      width: 34%;
    }
    td,
    th {
      font-size: 0.75rem;
      padding-inline: 0.25rem;
    }
    .detail {
      font-size: 0.6875rem;
    }
  }
</style>
