---
import { NBSP } from "../lib/format";

interface Props {
  text: string;
}

const AMOUNT = new RegExp(`(\\d[\\d${NBSP},]*${NBSP}?(?:Md€|M€|€|%))`, "u");
const { text } = Astro.props;
const parts = text.split(AMOUNT);
---

<p class="answer">{parts.map((part, index) => (index % 2 ? <strong>{part}</strong> : part))}</p>
