---
import { NBSP } from "../lib/format";
import type { TermId } from "../lib/glossary";
import Term from "./Term.astro";

interface Props {
  text: string;
}

const TERMS: Record<string, TermId> = {
  médiane: "mediane",
  PIB: "pib",
  CNCCFP: "cnccfp",
  HATVP: "hatvp",
};
const AMOUNT = `\\d[\\d${NBSP},]*${NBSP}?(?:Md€|M€|€|%)`;
const { text } = Astro.props;
const parts = text.split(new RegExp(`(${AMOUNT}|\\b(?:${Object.keys(TERMS).join("|")})\\b)`, "u"));
const firstLargeAmount = parts.findIndex((part) => /(?:Md€|M€)$/.test(part));
---

<p class="answer">
  {parts.map((part, index) =>
    TERMS[part] ? (
      <Term id={TERMS[part]}>{part}</Term>
    ) : index === firstLargeAmount ? (
      <strong>
        <Term id="million-milliard">{part}</Term>
      </strong>
    ) : index % 2 ? (
      <strong>{part}</strong>
    ) : (
      part
    ),
  )}
</p>
