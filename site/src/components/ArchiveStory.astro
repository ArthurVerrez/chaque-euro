---
import Icon from "./Icon.astro";
import type { Analysis } from "../lib/analyses";
import { formatDate } from "../lib/format";

interface Props {
  article: Analysis;
  topic: string;
  cover?: string | undefined;
}

const { article, topic, cover } = Astro.props;
const date = article.updated ?? article.published;
---

<article class:list={["story", { illustrated: cover }]}>
  <a href={`/analyses/${article.slug}`} aria-labelledby={`title-${article.slug}`}>
    {cover && <img src={cover} alt="" width="760" height="507" loading="lazy" decoding="async" />}
    <div class="copy">
      <div class="meta">
        <span>
          <Icon name={article.icon} size={15} /> {topic}
        </span>
        <time datetime={date}>
          {article.updated && "Mis à jour le "}
          {formatDate(date)}
        </time>
      </div>
      <h3 id={`title-${article.slug}`}>{article.title}</h3>
      <p>{article.summary}</p>
    </div>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</article>

<style>
  .story {
    min-width: 0;
    grid-column: 1 / -1;
    border-top: 1px solid var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 1rem;
    padding-block: 1.35rem;
    color: var(--ink);
    text-decoration: none;
  }

  .meta,
  .meta span {
    display: flex;
    align-items: center;
  }

  .meta {
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--subtle);
  }

  .meta span {
    gap: 0.375rem;
    color: var(--ink);
    font-weight: 650;
  }

  h3 {
    margin: 0.45rem 0 0.35rem;
    color: var(--ink);
    font: 400 clamp(1.8rem, 1.45rem + 1.2vw, 2.6rem) / 1.06 var(--display);
    letter-spacing: -0.018em;
  }

  p {
    max-width: 72ch;
    margin: 0;
    color: var(--subtle);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .arrow {
    color: var(--subtle);
    font-size: 1.35rem;
  }

  a:is(:hover, :focus-visible) h3,
  a:hover .arrow {
    color: var(--red);
  }

  .illustrated {
    border: 0;
  }

  .illustrated a {
    padding: 0 0 1.6rem;
    align-items: start;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2.1;
    object-fit: cover;
    object-position: center top;
    grid-column: 1 / -1;
    margin-bottom: 0.9rem;
  }

  .illustrated .arrow {
    line-height: 1;
  }

  @media (min-width: 48rem) {
    .illustrated {
      grid-column: span 1;
    }
  }
</style>
