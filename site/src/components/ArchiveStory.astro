---
import Icon from "./Icon.astro";
import { analysisCover, analysisTopic, type Analysis } from "../lib/analyses";
import { formatDate } from "../lib/format";

interface Props {
  article: Analysis;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const topic = analysisTopic(article.slug);
const cover = analysisCover(article.slug);
const date = article.updated ?? article.published;
---

<article class:list={["story", { illustrated: featured && cover }]}>
  <a href={`/analyses/${article.slug}`} aria-labelledby={`title-${article.slug}`}>
    {cover && (
      <img
        class:list={{ thumbnail: !featured }}
        src={featured ? cover.src : cover.thumbnail}
        alt=""
        width="360"
        height="240"
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="copy">
      <div class="meta">
        <span>
          <Icon name={article.icon} size={15} /> {topic?.label ?? "Analyse"}
        </span>
        <time datetime={date}>
          {article.updated && "Mis à jour le "}
          {formatDate(date)}
        </time>
      </div>
      <h3 id={`title-${article.slug}`}>{article.title}</h3>
      <p>{article.summary}</p>
    </div>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</article>

<style>
  .story {
    min-width: 0;
    grid-column: 1 / -1;
    border-top: 1px solid var(--border);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 1rem;
    padding-block: 1.35rem;
    color: var(--text);
    text-decoration: none;
  }

  .meta,
  .meta span {
    display: flex;
    align-items: center;
  }

  .meta {
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .meta span {
    gap: 0.375rem;
    color: var(--text);
    font-weight: 650;
  }

  h3 {
    margin: 0.45rem 0 0.35rem;
    color: var(--text);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  p {
    max-width: 72ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .arrow {
    color: var(--text-muted);
    font-size: 1.35rem;
  }

  a:is(:hover, :focus-visible) h3,
  a:hover .arrow {
    color: var(--link);
  }

  .illustrated {
    border: 0;
  }

  .illustrated a {
    padding: 0 0 1.6rem;
    align-items: start;
  }

  img {
    display: block;
    border-radius: var(--radius);
    width: 100%;
    height: auto;
    aspect-ratio: 2.1;
    object-fit: cover;
    object-position: center top;
    grid-column: 1 / -1;
    margin-bottom: 0.9rem;
  }

  .illustrated .arrow {
    line-height: 1;
  }

  a:has(.thumbnail) {
    grid-template-columns: clamp(5rem, 12vw, 9rem) minmax(0, 1fr) auto;
  }

  .thumbnail {
    grid-column: auto;
    aspect-ratio: 1.5;
    margin: 0;
  }

  @media (max-width: 36rem) {
    a:has(.thumbnail) {
      grid-template-columns: minmax(0, 1fr) 4.75rem;
      align-items: start;
      gap: 0.6rem;
    }

    .thumbnail {
      grid-column: 2;
      grid-row: 1;
    }

    .thumbnail + .copy {
      grid-column: 1;
      grid-row: 1;
    }

    .thumbnail ~ .arrow {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .illustrated {
      grid-column: span 1;
    }
  }
</style>
