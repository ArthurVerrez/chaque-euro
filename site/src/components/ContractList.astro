---
import Icon from "./Icon.astro";
import type { Contract, ContractRole } from "../lib/data";
import { formatDate, formatEuros } from "../lib/format";

interface Props {
  contracts: Contract[];
  role: ContractRole;
  caption: string;
}

const { contracts, role, caption } = Astro.props;
const flags: Record<string, string> = {
  aberrant: "Montant déclaré jugé aberrant par le consolidateur",
  suspect: "Montant signalé comme suspect, valeur conservée par le consolidateur",
  hors_norme: "Montant d'au moins 999 999 999 €, non compté",
};
---

<section class="contracts" aria-label={caption}>
  <h3>
    <Icon name="contract" />
    {caption}
  </h3>
  <ol>
    {contracts.map((contract) => (
      <li>
        <div class="main">
          <p class="who">
            <Icon name="contract" size={15} />
            {role === "titulaire" ? (
              contract.buyerSiren ? (
                <a href={`/organisation/${contract.buyerSiren}`}>{contract.buyerName}</a>
              ) : (
                <span>{contract.buyerName}</span>
              )
            ) : (
              <span>{contract.holdersLabel}</span>
            )}
          </p>
          <p class="subject">{contract.subject ?? "Objet non publié"}</p>
          <p class="meta">
            <span>Notifié le {formatDate(contract.notifiedOn)}</span>
            {contract.sourceUrl && <a href={contract.sourceUrl}>Voir la source</a>}
          </p>
        </div>
        <div class="figure">
          {contract.amount === null ? (
            <>
              <span class="muted small">Montant non retenu</span>
              {contract.declaredAmount !== null && (
                <span class="small">Déclaré : {formatEuros(contract.declaredAmount)}</span>
              )}
            </>
          ) : (
            <>
              <strong class="num">{formatEuros(contract.amount)}</strong>
              {contract.amountEstimated && <span class="flag">Estimation du consolidateur</span>}
              {contract.amountEstimated && contract.declaredAmount !== null && (
                <span class="small">Déclaré : {formatEuros(contract.declaredAmount)}</span>
              )}
              {!contract.amountCounted && <span class="flag">Non compté dans les totaux</span>}
              {contract.amountFlag && (
                <span class="flag">{flags[contract.amountFlag] ?? "Non compté"}</span>
              )}
              {contract.amountCounted && role === "titulaire" && contract.holders > 1 && (
                <span class="share">
                  {contract.holders} titulaires, part estimée {formatEuros(contract.share ?? 0)}
                </span>
              )}
            </>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  h3 {
    margin: 0 0 0.75rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 40rem) {
    li {
      grid-template-columns: minmax(0, 1fr) 12rem;
    }

    .figure {
      text-align: right;
    }
  }

  p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .who {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .subject {
    margin: 0.25rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .figure {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .figure strong {
    font-size: 1.125rem;
    color: var(--navy-900);
  }

  .flag,
  .share {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .who :global(svg) {
    margin-right: 0.375rem;
    vertical-align: -0.15em;
    color: var(--navy-800);
  }

  @media (max-width: 40rem) {
    li {
      gap: 0.25rem;
      padding: 0.75rem 0;
    }

    .subject {
      -webkit-line-clamp: 2;
      line-clamp: 2;
      font-size: 0.9375rem;
    }
  }
</style>
