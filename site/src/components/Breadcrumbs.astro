---
import Icon from "./Icon.astro";

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Fil d'Ariane">
  <ol>
    <li>
      <a href="/">
        <Icon name="home" size={14} />
        Accueil
      </a>
    </li>
    {items.map((item) => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  li {
    flex: none;
  }

  li:last-child {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  li + li::before {
    content: "›";
    margin-right: 0.25rem;
    color: var(--text-muted);
  }

  a {
    display: inline-block;
    padding: 0.6875rem 0;
    color: var(--text-secondary);
  }

  li:first-child a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
