---
import Icon from "./Icon.astro";
import Provenance from "./Provenance.astro";
import type { Provenance as ProvenanceData } from "../lib/data";
import type { IconName } from "../lib/icons";
interface Props {
  id: string;
  title: string;
  icon: IconName;
  provenance: ProvenanceData;
}
const { id, title, icon, provenance } = Astro.props;
---

<section class="chapter" id={id} aria-labelledby={`titre-${id}`}>
  <h2 id={`titre-${id}`}>
    <Icon name={icon} />
    {title}
  </h2>
  <div class="prose">
    <slot />
  </div>
  <div class="chart card">
    <slot name="chart" />
  </div>
  <Provenance provenance={provenance} />
</section>

<style>
  .chapter {
    padding: 3.5rem 0 1rem;
    scroll-margin-top: 5rem;
  }

  .chapter + .chapter {
    border-top: 1px solid var(--border);
  }

  h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.375rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .prose {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(strong) {
    color: var(--navy-900);
  }

  .chart {
    margin: 2rem 0 0;
  }

  @media (min-width: 48rem) {
    .chart {
      padding: 2rem;
    }
  }
</style>
