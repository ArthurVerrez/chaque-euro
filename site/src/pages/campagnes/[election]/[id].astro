---
import Democracy from "../../../layouts/Democracy.astro";
import Icon from "../../../components/Icon.astro";
import PublicTable from "../../../components/PublicTable.astro";
import Provenance from "../../../components/Provenance.astro";
import { getCampaignAccount } from "../../../lib/data";
import { electionLabels } from "../../../lib/democracy";
import { formatDate, formatEuroCents } from "../../../lib/format";
const data = await getCampaignAccount(Astro.params.election ?? "", Astro.params.id ?? "");
if (!data) return Astro.redirect("/404");
const { account: a, lines } = data;
const money = (v: number | null) => (v === null ? "Non renseigné" : formatEuroCents(v));
const totals = [
  ["Dépenses déclarées", a.declared_expenses_cents],
  ["Dépenses retenues", a.retained_expenses_cents],
  ["Recettes déclarées", a.declared_revenue_cents],
  ["Recettes retenues", a.retained_revenue_cents],
  ["Apport personnel retenu", a.personal_contribution_cents],
  ["Dons retenus", a.donations_cents],
  ["Apports de partis retenus", a.party_contribution_cents],
  ["Concours en nature retenus", a.in_kind_cents],
  ["Remboursement forfaitaire fixé (RFE)", a.rfe_fixed_cents],
  ["Transport outre-mer fixé (FT)", a.transport_fixed_cents],
  ["Dévolution", a.devolution_cents],
] as const;
---

<Democracy
  title={a.candidate_name}
  description={`Compte de campagne publié, ${electionLabels[a.election_id] ?? a.election_id}.`}
  icon="campaign"
  answer={`${electionLabels[a.election_id]} · ${a.constituency}. ${a.decision_code} : ${a.decision_label}.`}
  figures={[
    { icon: "spending", label: "Dépenses déclarées", value: money(a.declared_expenses_cents) },
    { icon: "scale", label: "Dépenses retenues", value: money(a.retained_expenses_cents) },
    {
      icon: "refund",
      label: "Remboursement RFE fixé",
      value: money(a.rfe_fixed_cents),
      note: "Paiement non attesté",
    },
  ]}
  provenance={data.provenance}
  sections={[
    { id: "montants", label: "Montants", icon: "euro" },
    { id: "details", label: "Détail publié", icon: "list" },
  ]}
>
  <p slot="caveat">
    Compte publié le {formatDate(a.published_on)}. Il ne dit rien d’une éventuelle procédure
    judiciaire.
  </p>
  <section id="montants" class="section">
    <div class="section-head">
      <h2>
        <Icon name="euro" />
        Montants du compte
      </h2>
    </div>
    <PublicTable
      caption="Postes du compte"
      columns={["Poste", "Montant"]}
      rows={totals.map(([label, value]) => [{ text: label }, { text: money(value) }])}
    />
    <Provenance provenance={data.provenance} />
  </section>
  <section id="details" class="section">
    <div class="section-head">
      <h2>
        <Icon name="list" />
        Détail déclaré et retenu
      </h2>
    </div>
    <PublicTable
      caption="Catégories publiées"
      columns={["Base", "Poste", "Montant"]}
      rows={lines.map((l) => [
        { text: l.basis === "declared" ? "Déclaré" : "Retenu / version suivante" },
        { text: l.category },
        { text: money(l.amount_cents) },
      ])}
    />
    <Provenance provenance={data.provenance} />
  </section>
</Democracy>
