import { getDownloads } from "../lib/data";
import { formatBytes, formatDayMonth, formatNumber, formatYear, plural } from "../lib/format";
import type { IconName } from "../lib/icons";

const downloads = await getDownloads();
const TABLES: Record<string, { label: string; icon: IconName }> = {
