  public_accounts: { label: "Comptes des administrations par nature", icon: "spending" },
  public_functions: { label: "Argent public par usage", icon: "flow" },
  local_accounts: { label: "Comptes des collectivités par niveau", icon: "administration" },
  commune_taxes: { label: "Fiscalité locale par bénéficiaire", icon: "localTax" },
  tax_strata: { label: "Médianes des taux et bases fiscales", icon: "scale" },
  commune_income: { label: "Impôt sur le revenu par commune", icon: "incomeTax" },
  commune_turnout: { label: "Participation électorale par commune", icon: "vote" },
  department_turnout: { label: "Participation électorale par département", icon: "vote" },
  commune_dgf_history: { label: "DGF dans les comptes communaux", icon: "grant" },
  commune_functions: { label: "Dépenses des communes par service", icon: "town" },
  commune_function_strata: { label: "Médianes par service", icon: "town" },
  commune_function_labels: { label: "Libellés des services", icon: "list" },
  communes: { label: "Communes", icon: "town" },
  commune_years: { label: "Population des communes par année", icon: "people" },
  commune_finances: { label: "Comptes des communes", icon: "spending" },
  finance_items: { label: "Postes comptables", icon: "list" },
  strata: { label: "Médianes par taille de commune", icon: "scale" },
  departements: { label: "Départements", icon: "map" },
  facts: { label: "Chiffres clés", icon: "trend" },
  timeline: { label: "Marchés publiés par année", icon: "columns" },
};
const GROUPS: { id: string; title: string; icon: IconName; tables: string[] }[] = [
  {
    id: "protection-sociale",
    title: "Protection sociale et santé",
    icon: "socialSecurity",
    tables: [
      "social_branches",
      "social_ondam",
      "health_payers",
      "pension_indicators",
      "family_benefits",
      "unemployment_accounts",
      "social_benefits",
    ],
  },
  {
    id: "analyses",
    title: "Données des analyses",
    icon: "analysis",
    tables: [
      "rail_network",
      "deficit_series",
      "eu_flows",
      "eu_headings",
      "paris_comparison",
      "paris_context",
      "rail_transfers",
      "rail_revenue",
      "rail_context",
      "student_scholarships",
      "student_budget",
      "student_cost",
    ],
  },
  {
    id: "documents",
    title: "Documents et administrations",
    icon: "journal",
    tables: [
      "official_journals",
      "official_texts",
      "legislative_files",
      "legislative_file_refs",
      "legislative_events",
      "legislative_documents",
      "budget_legislation",
      "administrations",
      "administration_relations",
      "administration_pivots",
      "administration_coverage",
    ],
  },
  {
    id: "democratie",
    title: "Lobbying et financement politique",
    icon: "politicalFinance",
    tables: [
      "lobbying_organisations",
      "lobbying_exercises",
      "lobbying_activities",
      "lobbying_targets",
      "lobbying_defaults",
      "lobbying_quarters",
      "lobbying_crossrefs",
      "eu_lobbying",
      "eu_lobbying_interests",
      "party_accounts",
      "party_aid_losses",
    ],
  },
  {
    id: "elus",
    title: "Élus, campagnes et moyens publics",
    icon: "elected",
    tables: [
      "public_people",
      "public_organs",
      "public_mandates",
      "mandate_constituencies",
      "commune_constituencies",
      "public_ballots",
      "public_votes",
      "public_vote_corrections",
      "public_person_metrics",
      "interest_declarations",
      "declared_interests",
      "campaign_accounts",
      "campaign_account_lines",
      "campaign_decisions",
      "rne_statistics",
      "local_executives",
      "cada_opinions",
      "expense_reference_values",
      "cabinet_statistics",
      "transparency_alerts",
    ],
  },
  {
    id: "marches",
    title: "Organisations et marchés publics",
    icon: "contract",
    tables: [
      "orgs",
      "org_years",
      "org_counterparts",
      "org_groups",
      "org_group_members",
      "org_group_amounts",
      "contracts",
      "org_contracts",
      "source_files",
      "procurement_breakdown",
      "procurement_quality",
      "procurement_competition",
      "procurement_latest",
      "procurement_notices",
      "procurement_projects",
      "competition_decisions",
      "competition_companies",
    ],
  },
  { id: "subventions", title: "Versements de l'État", icon: "grant", tables: ["grants"] },
  {
    id: "budget",
    title: "Budget de l'État et dépense publique",
    icon: "state",
    tables: [
      "budget",
      "revenue",
      "budget_voted",
      "public_finances",
      "public_accounts",
      "public_functions",
      "state_monthly",
      "state_titles",
      "state_ministries",
      "state_assets",
      "compulsory_levies",
      "european_finances",
      "european_functions",
      "quarterly_debt",
      "green_budget",
    ],
  },
  {
    id: "communes",
    title: "Communes et départements",
    icon: "town",
    tables: [
      "local_accounts",
      "commune_taxes",
      "tax_strata",
      "commune_income",
      "commune_turnout",
      "department_turnout",
      "commune_dgf_history",
      "commune_functions",
      "commune_function_strata",
      "commune_function_labels",
      "communes",
      "commune_years",
      "commune_finances",
      "finance_items",
      "strata",
      "departements",
    ],
  },
  { id: "reperes", title: "Repères", icon: "trend", tables: ["facts", "timeline"] },
];
const byName = new Map(downloads.tables.map((table) => [table.table, table]));
const grouped = new Set(GROUPS.flatMap((group) => group.tables));
const groups = [
  ...GROUPS,
  {
    id: "autres",
    title: "Autres données",
    icon: "list" as const,
    tables: downloads.tables.map((table) => table.table).filter((name) => !grouped.has(name)),
  },
]
  .map((group) => ({ ...group, tables: group.tables.flatMap((name) => byName.get(name) ?? []) }))
  .filter((group) => group.tables.length > 0);
const files = downloads.tables.flatMap((table) => table.files);
const FORMATS: Record<string, { label: string; icon: IconName }> = {
  csv: { label: "CSV", icon: "csv" },
  parquet: { label: "Parquet", icon: "parquet" },
};
---

<Base
  title="Télécharger les données"
  description="Toutes les tables calculées par Chaque Euro, en CSV et en Parquet : organisations, marchés publics, subventions, budget de l'État, comptes des communes."
>
  <header class="page-head">
    <div class="container">
      <Breadcrumbs items={[{ label: "Télécharger les données" }]} />
      <div class="entity">
        <Icon name="download" />
        <h1>Télécharger les données</h1>
      </div>
      <p class="lead">CSV pour tableur, Parquet pour outil de données.</p>
      <KeyFigures
        figures={[
          {
            icon: "list",
            label: "Jeux de données",
            value: formatNumber(downloads.tables.length),
          },
          {
            icon: "download",
            label: "Fichiers",
            value: formatNumber(files.length),
          },
          {
            icon: "source",
            label: "Taille totale",
            value: formatBytes(files.reduce((total, file) => total + file.bytes, 0)),
          },
          {
            icon: "calendar",
            label: "Mise à jour",
            value: downloads.builtAt ? formatDayMonth(downloads.builtAt) : "n.d.",
            note: downloads.builtAt ? formatYear(downloads.builtAt) : undefined,
          },
        ]}
      />
    </div>
  </header>
  <Toc
    items={groups.map((group) => ({ href: `#${group.id}`, label: group.title, icon: group.icon }))}
  />

  <div class="container">
    {groups.map((group) => (
      <section class="section" id={group.id} aria-labelledby={`titre-${group.id}`}>
        <div class="section-head">
          <h2 id={`titre-${group.id}`}>
            <Icon name={group.icon} />
            {group.title}
          </h2>
        </div>
        <ul class="tables">
          {group.tables.map((table) => (
            <li class="card table">
              <div class="about">
                <h3>
                  <Icon name={TABLES[table.table]?.icon ?? "list"} />
                  {TABLES[table.table]?.label ?? table.table}
                </h3>
                <p>{table.description}</p>
                <p class="meta small">
                  <span>
                    <Icon name="count" size={14} />
                    {plural(table.rows, "ligne", "lignes")}
                  </span>
                  <span>
                    <Icon name="code" size={14} />
                    <code>{table.table}</code>
                  </span>
                </p>
              </div>
              <div class="files">
                {[...table.files]
                  .sort((a, b) => a.format.localeCompare(b.format))
                  .map((file) => (
                    <a class="file" href={`/telechargements/fichiers/${file.file}`} download>
                      <Icon name={FORMATS[file.format]?.icon ?? "download"} size={18} />
                      <span>
                        {FORMATS[file.format]?.label ?? file.format}
                        <span class="size">{formatBytes(file.bytes)}</span>
                      </span>
                      <Icon name="download" size={16} />
                    </a>
                  ))}
                <details class="hashes small">
                  <summary>Empreintes SHA-256</summary>
                  {table.files.map((file) => (
                    <p>
                      {file.file} : <code>{file.sha256}</code>
                    </p>
                  ))}
                </details>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="section" aria-labelledby="titre-usage">
      <div class="section-head">
        <h2 id="titre-usage">
          <Icon name="book" />
          Utiliser ces fichiers
        </h2>
      </div>
      <div class="grid">
        <Explainer title="Dans un tableur">
          <p>
            Décompressez l’archive CSV, puis ouvrez le fichier dans Excel ou LibreOffice. Les
            comptes des communes dépassent la limite d’un million de lignes d’Excel : utilisez un
            outil de données et le Parquet.
          </p>
        </Explainer>
        <Explainer title="Avec un outil de données">
          <p>
            Les fichiers Parquet se lisent directement avec DuckDB, Python ou R, par exemple :{" "}
            <code>select * from 'commune_finances.parquet' where insee = '69123'</code>.
          </p>
        </Explainer>
        <Explainer title="Réutilisation">
          <p>
            Les conditions de réutilisation dépendent de chaque source. Citez les producteurs et
            consultez les licences et le cadre de réutilisation dans
            <a href="/methodologie#sources">Méthode et sources</a>. Les entrepreneurs individuels
            n'y sont jamais nommés.
          </p>
        </Explainer>
      </div>
    </section>
  </div>
</Base>

<style>
  .tables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .table {
    display: grid;
    gap: 1rem 2rem;
  }

  @media (min-width: 56rem) {
    .table {
      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: start;
    }
  }

  .about p {
    margin: 0.25rem 0 0;
    color: var(--text-secondary);
  }

  .about .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
  }

  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .files {
    display: grid;
    gap: 0.5rem;
  }

  .file {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .file:hover {
    border-color: var(--link);
    color: var(--link);
    background: var(--navy-50);
  }

  .file > span {
    flex: 1;
  }

  .size {
    margin-left: 0.375rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .file :global(svg) {
    flex: none;
    color: var(--navy-800);
  }

  .hashes summary {
    color: var(--link);
  }

  .hashes p {
    margin: 0.375rem 0 0;
    overflow-wrap: anywhere;
    color: var(--text-muted);
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
  }
</style>
