  european_finances: { label: "Finances publiques en Europe", icon: "europe" },
  european_functions: { label: "Dépenses publiques européennes par fonction", icon: "europe" },
  quarterly_debt: { label: "Dette publique trimestrielle", icon: "trend" },
  social_benefits: { label: "Prestations de protection sociale", icon: "socialSecurity" },
