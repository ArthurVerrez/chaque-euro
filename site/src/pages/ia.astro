---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import Term from "../components/Term.astro";
import Base from "../layouts/Base.astro";
import type { IconName } from "../lib/icons";
import { PUBLIC_ORIGIN } from "../lib/site";

interface Client {
  name: string;
  steps: string;
  snippet: string;
  install?: { label: string; href: string };
}

const endpoint = new URL("/mcp", PUBLIC_ORIGIN).href;
const server = "chaque-euro";
const json = (value: object) => JSON.stringify(value, null, 2);
const groups: { id: string; title: string; icon: IconName; clients: Client[] }[] = [
  {
    id: "applications",
    title: "Dans une application",
    icon: "assistant",
    clients: [
      {
        name: "Claude",
        steps:
          "Personnaliser, Connecteurs, Ajouter, puis Ajouter un connecteur personnalisé. Nommez-le Chaque Euro, collez cette adresse et choisissez sans connexion. Possible avec l'offre gratuite.",
        snippet: endpoint,
      },
      {
        name: "ChatGPT",
        steps:
          "Paramètres, Applications\u00a0: activez le mode développeur dans les paramètres avancés, puis créez une application avec cette adresse, sans authentification. Selon votre abonnement.",
        snippet: endpoint,
      },
      {
        name: "Le Chat (Mistral)",
        steps:
          "Connecteurs, Ajouter un connecteur, onglet Connecteur MCP personnalisé. Nommez-le chaque-euro, collez cette adresse, puis Connecter.",
        snippet: endpoint,
      },
    ],
  },
  {
    id: "developpeurs",
    title: "Dans un outil de développement",
    icon: "code",
    clients: [
      {
        name: "Claude Code",
        steps: "Dans un terminal\u00a0:",
        snippet: `claude mcp add --transport http ${server} ${endpoint}`,
      },
      {
        name: "Codex",
        steps:
          "Dans un terminal. L'extension et l'application Codex utilisent la même configuration.",
        snippet: `codex mcp add ${server} --url ${endpoint}`,
      },
      {
        name: "Gemini CLI",
        steps: "Dans un terminal\u00a0:",
        snippet: `gemini mcp add --transport http --scope user ${server} ${endpoint}`,
      },
      {
        name: "Cursor",
        steps: "Installez en un clic, ou ajoutez ce bloc à ~/.cursor/mcp.json.",
        snippet: json({ mcpServers: { [server]: { url: endpoint } } }),
        install: {
          label: "Installer",
          href: `cursor://anysphere.cursor-deeplink/mcp/install?name=${server}&config=${encodeURIComponent(btoa(JSON.stringify({ url: endpoint })))}`,
        },
      },
      {
        name: "VS Code",
        steps: "Dans un terminal, pour GitHub Copilot\u00a0:",
        snippet: `code --add-mcp '${JSON.stringify({ name: server, type: "http", url: endpoint })}'`,
      },
      {
        name: "Windsurf",
        steps: "Ajoutez ce bloc au fichier mcp_config.json de Windsurf.",
        snippet: json({ mcpServers: { [server]: { serverUrl: endpoint } } }),
      },
      {
        name: "Autres",
        steps: "Serveur MCP distant, transport Streamable HTTP, sans authentification\u00a0:",
        snippet: endpoint,
      },
    ],
  },
];
const examples = [
  "Combien Lyon dépense-t-elle par habitant, comparé aux villes de même taille ?",
  "Quel argent public reçoit la SNCF ?",
  "Qui sont les députés de Rennes ?",
  "Où va le budget de l'État ?",
];
---

<Base
  title="MCP"
  description="Le serveur MCP de Chaque Euro : posez vos questions sur l'argent public à Claude, ChatGPT, Le Chat, Codex ou un autre assistant, qui interroge les données du site et cite les sources."
>
  <header class="page-head">
    <div class="container">
      <Breadcrumbs items={[{ label: "MCP" }]} />
      <div class="entity">
        <Icon name="assistant" />
        <h1>MCP</h1>
      </div>
      <p class="lead">
        Votre assistant d'IA interroge les données du site et cite les sources. Gratuit, sans
        compte, en lecture seule.
      </p>
      <div class="endpoint">
        <span>
          Adresse du serveur <Term id="mcp">MCP</Term>
        </span>
        <code>{endpoint}</code>
        <button type="button" data-copy={endpoint}>
          <Icon name="copy" size={16} />
          <span>Copier</span>
        </button>
      </div>
    </div>
  </header>

  <div class="container">
    {groups.map((group) => (
      <section class="section" aria-labelledby={`titre-${group.id}`}>
        <h2 id={`titre-${group.id}`}>
          <Icon name={group.icon} />
          {group.title}
        </h2>
        <ul class="clients">
          {group.clients.map((client) => (
            <li class="client">
              <h3>{client.name}</h3>
              <p>{client.steps}</p>
              <div class="use">
                <pre class="snippet"><code>{client.snippet}</code></pre>
                <div class="actions">
                  <button type="button" data-copy={client.snippet}>
                    <Icon name="copy" size={16} />
                    <span>Copier</span>
                  </button>
                  {client.install && (
                    <a class="install" href={client.install.href}>
                      <Icon name="download" size={16} />
                      {client.install.label}
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="section" aria-labelledby="titre-exemples">
      <h2 id="titre-exemples">
        <Icon name="answer" />
        Exemples de questions
      </h2>
      <ul class="examples">
        {examples.map((example) => (
          <li>«&nbsp;{example}&nbsp;»</li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = button.querySelector("span");
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      if (!label) return;
      label.textContent = "Copié";
      setTimeout(() => (label.textContent = "Copier"), 2000);
    });
  }
</script>

<style>
  .endpoint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    max-width: 48rem;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .endpoint > span {
    flex-basis: 100%;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .endpoint code {
    flex: 1 1 14rem;
    font-size: 1.0625rem;
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  button,
  .install {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 650;
    cursor: pointer;
  }

  button {
    border: 0;
    background: var(--navy-900);
    color: #fff;
  }

  button:focus-visible,
  .install:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .clients {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .client {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .use {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
  }

  .snippet {
    min-width: 0;
    margin: 0;
    padding: 0.75rem;
    border-radius: 10px;
    background: var(--navy-50);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .actions {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: 0.5rem;
  }

  .actions button,
  .install {
    justify-content: center;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--link);
    text-decoration: none;
  }

  .client h3 {
    margin: 0;
    font-size: 1.125rem;
  }

  .client p {
    margin: 0;
    color: var(--text-secondary);
    overflow-wrap: break-word;
  }

  .examples {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .examples li {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
</style>
