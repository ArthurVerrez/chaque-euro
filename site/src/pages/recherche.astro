---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import SearchForm from "../components/SearchForm.astro";
import Base from "../layouts/Base.astro";
import { search } from "../lib/data";
import { NBSP } from "../lib/format";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const compact = query.replace(/\s/g, "");
if (/^\d{9}$/.test(compact)) return Astro.redirect(`/organisation/${compact}`);
if (/^\d{14}$/.test(compact)) return Astro.redirect(`/organisation/${compact.slice(0, 9)}`);
if (/^[0-9][0-9AB][0-9]{3}$/i.test(compact)) {
  return Astro.redirect(`/commune/${compact.toUpperCase()}`);
}
const results = query.length >= 2 ? await search(query) : [];
const groups = [...new Set(results.map((result) => result.group))].map((name) => ({
  name,
  results: results.filter((result) => result.group === name),
}));
const summary =
  results.length === 0
    ? `Aucun résultat pour «${NBSP}${query}${NBSP}».`
    : `${results.length} résultat${results.length > 1 ? "s" : ""} pour «${NBSP}${query}${NBSP}».`;
---

<Base
  title={query ? `Recherche : ${query}` : "Rechercher"}
  description="Cherchez un thème, un responsable public, une commune ou une organisation."
  noindex
>
  <header class="page-head">
    <div class="container">
      <Breadcrumbs items={[{ label: "Rechercher" }]} />
      <div class="entity">
        <Icon name="search" />
        <h1>Rechercher</h1>
      </div>
      <p class="lead">Un sujet, un responsable public, une commune ou une organisation.</p>
      <SearchForm query={query} autofocus={!query} />
    </div>
  </header>
  <div class="container">
    {query && (
      <section class="section" aria-live="polite">
        <p class="muted">{summary}</p>
        {groups.map((group) => (
          <section class="result-group" aria-label={group.name}>
            <h2>
              <Icon name={group.results[0]!.icon} />
              {group.name}
            </h2>
            <ul class="results">
              {group.results.map((result) => (
                <li class="card result">
                  <span class="result-icon">
                    <Icon name={result.icon} size={22} />
                  </span>
                  <span class="result-body">
                    <a href={result.href}>{result.name}</a>
                    <span class="muted small">
                      {result.kind}
                      {result.detail && ` · ${result.detail}`}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
        {results.length === 0 && (
          <p>
            Essayez un autre mot, ou consultez l’
            <a href="/argent-public">
              <Icon name="euro" size={15} />
              argent public
            </a>
            , les{" "}
            <a href="/elus">
              <Icon name="elected" size={15} />
              élus
            </a>{" "}
            et les{" "}
            <a href="/communes">
              <Icon name="town" size={15} />
              communes
            </a>
            .
          </p>
        )}
      </section>
    )}
  </div>
</Base>

<style>
  .result-group {
    margin-top: 2rem;
  }

  .result-group h2 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .result {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
  }

  .result-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: var(--navy-100);
    color: var(--navy-900);
  }

  .result-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .result-body a {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--navy-900);
    text-decoration-color: rgb(29 79 174 / 35%);
  }

  .result-body a:hover {
    color: var(--link);
    text-decoration-color: currentcolor;
  }
</style>
