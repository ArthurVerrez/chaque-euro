---
import Democracy from "../../layouts/Democracy.astro";
import Icon from "../../components/Icon.astro";
import PublicTable from "../../components/PublicTable.astro";
import PublicPagination from "../../components/PublicPagination.astro";
import Provenance from "../../components/Provenance.astro";
import Explainer from "../../components/Explainer.astro";
import Term from "../../components/Term.astro";
import AddressDeputy from "../../components/AddressDeputy.astro";
import { getElectedIndex, getCommuneRepresentatives } from "../../lib/data";
import { formatDate, formatNumber } from "../../lib/format";
import { pageNumber, roleLabels } from "../../lib/democracy";
const params = Astro.url.searchParams;
const filters = {
  q: params.get("q") ?? "",
  chamber: params.get("chambre") ?? "",
  group: params.get("groupe") ?? "",
  department: params.get("departement") ?? "",
  page: pageNumber(params.get("page")),
};
const data = await getElectedIndex(filters);
const communeQuery = (params.get("commune") ?? "").trim();
const local = communeQuery ? await getCommuneRepresentatives(communeQuery) : null;
const figure = (kind: string, label: string) => ({
  icon: "elected" as const,
  label,
  value: formatNumber(data.chambers.find((r) => r.role_kind === kind)?.count ?? 0),
  note: `Relevé du ${formatDate(data.provenance.citations.find((c) => c.source.id === (kind === "senator" ? "senat-members" : kind === "minister" ? "an-history" : "an-members"))?.source.retrievedAt ?? null)}`,
});
---

<Democracy
  title="Élus"
  description="Mandats, groupes et votes publics des parlementaires, fonctions gouvernementales et répertoire des élus locaux."
  icon="elected"
  answer="Retrouvez vos députés et sénateurs, et leurs votes publics."
  figures={[
    figure("deputy", "Députés en exercice"),
    figure("senator", "Sénateurs en exercice"),
    figure("minister", "Fonctions gouvernementales"),
  ]}
  provenance={data.provenance}
  sections={[
    { id: "trouver", label: "Votre commune", icon: "town" },
    { id: "repertoire", label: "Rechercher", icon: "search" },
    { id: "scrutins", label: "Votes récents", icon: "vote" },
  ]}
>
  <section id="trouver" class="section" aria-labelledby="titre-trouver">
    <div class="section-head">
      <h2 id="titre-trouver">
        <Icon name="town" />
        Trouver votre député
      </h2>
    </div>
    <AddressDeputy />
    <form class="filters" method="get" action="/elus#trouver">
      <label>
        Votre commune
        <input
          name="commune"
          type="search"
          value={local?.commune?.name ?? communeQuery}
          placeholder="Nom ou code Insee"
          required
        />
      </label>
      <button type="submit">Rechercher</button>
    </form>
    {local && (
      <div aria-live="polite">
        {local.commune ? (
          <>
            <h3>
              <Icon name="town" size={20} />
              {local.commune.name} ({local.commune.department})
            </h3>
            {new Set(local.deputies.map((p) => p.constituency)).size > 1 && (
              <p>
                Votre commune est partagée entre plusieurs{" "}
                <Term id="circonscription-legislative">circonscriptions législatives</Term>.
              </p>
            )}
            {local.deputies.length === 1 && (
              <p>
                Votre commune appartient à une seule{" "}
                <Term id="circonscription-legislative">circonscription législative</Term>.
              </p>
            )}
            {local.deputies.length > 0 ? (
              <PublicTable
                caption="Députés en exercice, XVIIe législature"
                columns={["Circonscription", "Député ou députée", "Groupe"]}
                rows={local.deputies.map((p) => [
                  { text: `${p.constituency}${p.constituency === 1 ? "re" : "e"} circonscription` },
                  {
                    text: p.name ?? "Mandat en exercice non disponible",
                    href: p.id ? `/elus/${p.id}` : null,
                  },
                  { text: p.group ?? "Non renseigné" },
                ])}
              />
            ) : (
              <p>Correspondance avec les circonscriptions non disponible.</p>
            )}
            <PublicTable
              caption={`Sénateurs et sénatrices : ${local.commune.departmentName}`}
              columns={["Nom", "Groupe"]}
              rows={local.senators.map((p) => [
                { text: p.display_name, href: `/elus/${p.id}` },
                { text: p.group_label ?? "Non renseigné" },
              ])}
            />
          </>
        ) : local.communes.length > 0 ? (
          <PublicTable
            caption="Choisissez votre commune"
            columns={["Commune", "Département"]}
            rows={local.communes.map((c) => [
              { text: c.name, href: `/elus?commune=${c.insee}#trouver` },
              { text: `${c.departmentName} (${c.department})` },
            ])}
          />
        ) : (
          <p>Aucune commune trouvée. Essayez son code Insee ou un autre nom.</p>
        )}
        <Explainer title="Périmètre et actualisation">
          <p>
            Les mandats sont ceux du dernier répertoire officiel importé. Les changements ultérieurs
            peuvent manquer. Pour une commune partagée, la recherche par adresse donne un repérage
            indicatif à partir des contours simplifiés de l’Insee.
          </p>
          <p>
            Le découpage est celui des législatives de 2024. Les fusions communales sont rapprochées
            avec le Code officiel géographique 2025. Une scission ambiguë reste non disponible.
          </p>
        </Explainer>
        <Provenance provenance={local.provenance} />
      </div>
    )}
  </section>
  <section id="repertoire" class="section">
    <div class="section-head">
      <h2>
        <Icon name="elected" />
        Rechercher par nom
      </h2>
    </div>
    <form class="filters" method="get">
      <label>
        Nom
        <input name="q" type="search" value={filters.q} />
      </label>
      <label>
        Chambre ou fonction
        <select name="chambre">
          <option value="">Toutes</option>
          {[
            ["AN", "Assemblée nationale"],
            ["SENAT", "Sénat"],
            ["minister", "Gouvernement (répertoire AN)"],
          ].map(([value, label]) => (
            <option value={value} selected={filters.chamber === value}>
              {label}
            </option>
          ))}
        </select>
      </label>
      <label>
        Groupe
        <select name="groupe">
          <option value="">Tous</option>
          {data.groups.map((r) => (
            <option selected={filters.group === r.label}>{r.label}</option>
          ))}
        </select>
      </label>
      <label>
        Département
        <select name="departement">
          <option value="">Tous</option>
          {data.departments.map((r) => (
            <option value={r.code} selected={filters.department === r.code}>
              {r.code} · {r.label}
            </option>
          ))}
        </select>
      </label>
      <button type="submit">Rechercher</button>
    </form>
    <PublicTable
      caption="Fonctions en cours"
      columns={["Nom", "Fonction", "Territoire", "Groupe"]}
      rows={data.people.map((p) => [
        { text: p.display_name, href: `/elus/${p.id}` },
        { text: roleLabels[p.role_kind] ?? p.role_kind },
        { text: p.territory_label ?? "Non renseigné" },
        { text: p.group_label ?? "Non renseigné" },
      ])}
    />
    <PublicPagination page={filters.page} count={data.count} />
    <div class="related">
      <a href="/elus/registre">
        <Icon name="town" size={18} />
        Répertoire national et maires
      </a>
      <a href="/campagnes">
        <Icon name="campaign" size={18} />
        Comptes de campagne
      </a>
      <a href="/train-de-vie">
        <Icon name="spending" size={18} />
        Indemnités et moyens
      </a>
    </div>
    <Provenance provenance={data.provenance}>
      <p>
        Les membres du gouvernement viennent du répertoire de l’Assemblée nationale. Le
        rapprochement complet avec les décrets de nomination reste à faire.
      </p>
    </Provenance>
  </section>
  <section id="scrutins" class="section">
    <div class="section-head">
      <h2>
        <Icon name="vote" />
        Scrutins publics récents
      </h2>
    </div>
    <PublicTable
      caption="Derniers scrutins, Assemblée et Sénat"
      columns={["Date", "Chambre", "Scrutin"]}
      rows={data.ballots.map((b) => [
        { text: formatDate(b.voted_on) },
        { text: b.chamber === "AN" ? "Assemblée nationale" : "Sénat" },
        { text: b.title, href: `/votes/${b.id}` },
      ])}
    />
    <Provenance provenance={data.voteProvenance} />
  </section>
</Democracy>
