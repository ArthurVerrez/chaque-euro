---
import Democracy from "../../layouts/Democracy.astro";
import Icon from "../../components/Icon.astro";
import PublicTable from "../../components/PublicTable.astro";
import PublicPagination from "../../components/PublicPagination.astro";
import Provenance from "../../components/Provenance.astro";
import BarList from "../../components/BarList.astro";
import { getElectedRegister } from "../../lib/data";
import { pageNumber, registerLabels } from "../../lib/democracy";
import { formatDate, formatNumber } from "../../lib/format";
const params = Astro.url.searchParams;
const q = params.get("q") ?? "";
const page = pageNumber(params.get("page"));
const department = params.get("departement") ?? "";
const data = await getElectedRegister(q, page, department);
const items = (totals: Record<string, number>, labels: Record<string, string> = {}) =>
  Object.entries(totals).map(([label, value]) => ({
    icon: "elected" as const,
    label: labels[label] ?? label,
    value,
    display: formatNumber(value),
  }));
---

<Democracy
  title="Répertoire national des élus"
  description="Répartition des mandats du RNE et répertoire minimisé des maires, millésimes 2026."
  icon="elected"
  answer="Les mandats et fonctions inscrits au répertoire national des élus."
  figures={[
    {
      icon: "list",
      label: "Lignes de mandats ou fonctions",
      value: formatNumber(data.records),
      note: department ? `Département ${department}` : "Toutes catégories",
    },
    {
      icon: "town",
      label: "Lignes de maires",
      value: formatNumber(data.mayors),
    },
  ]}
  provenance={data.provenance}
  sections={[
    { id: "repartition", label: "Répartition", icon: "bars" },
    { id: "maires", label: "Maires", icon: "town" },
  ]}
>
  <p slot="caveat">
    Une même personne peut avoir plusieurs mandats : ces chiffres comptent des lignes, pas des
    personnes.
  </p>
  <section id="repartition" class="section">
    <div class="section-head">
      <h2>
        <Icon name="bars" />
        Répartitions par mandat
      </h2>
    </div>
    <form class="filters" method="get">
      <label>
        Code département
        <input name="departement" value={department} />
      </label>
      <button type="submit">Filtrer les statistiques</button>
    </form>
    <div class="reference-grid">
      <BarList caption="Par mandat ou fonction" items={items(data.byMandate, registerLabels)} />
      <BarList caption="Par sexe" items={items(data.bySex)} />
      <BarList caption="Par âge" items={items(data.byAge)} />
    </div>
    <details>
      <summary>Répartition par département</summary>
      <PublicTable
        caption="Lignes par département"
        columns={["Code département", "Lignes"]}
        rows={Object.entries(data.byDepartment)
          .sort(([a], [b]) => a.localeCompare(b))
          .map(([code, value]) => [{ text: code }, { text: formatNumber(value) }])}
      />
    </details>
    <Provenance provenance={data.provenance}>
      <p>
        Sexe et âge ne sont publiés qu’en totaux, l’âge à la date du fichier. Fichier d’août 2026,
        sauf AFE et conseillers consulaires : mai 2026. Pour les parlementaires en exercice, les
        répertoires de l’Assemblée et du Sénat sont plus récents.
      </p>
    </Provenance>
  </section>
  <section id="maires" class="section">
    <div class="section-head">
      <h2>
        <Icon name="town" />
        Maires : fonctions publiques
      </h2>
    </div>
    <form class="filters" method="get">
      <label>
        Nom ou commune
        <input name="q" type="search" value={q} />
      </label>
      <button type="submit">Rechercher</button>
    </form>
    <PublicTable
      caption="Maires par commune"
      columns={["Nom", "Commune", "Début de fonction"]}
      rows={data.executives.map((r) => [
        { text: r.display_name, href: `/elus/locaux/${r.id}` },
        {
          text: `${r.territory_label} · ${r.department_code}`,
          href: `/commune/${r.territory_code}`,
        },
        { text: formatDate(r.starts_on) },
      ])}
    />
    <PublicPagination page={page} count={data.count} />
    <Provenance provenance={data.provenance}>
      <p>Seuls le nom, la commune et la date de début sont publiés, sans naissance ni contact.</p>
    </Provenance>
  </section>
</Democracy>
