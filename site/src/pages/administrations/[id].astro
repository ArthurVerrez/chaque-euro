---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import Provenance from "../../components/Provenance.astro";
import { getAdministration } from "../../lib/data";
import { formatDate, formatNumber } from "../../lib/format";
import DocumentContent from "../../components/DocumentContent.astro";
const data = await getAdministration(Astro.params.id ?? "");
if (!data) return Astro.redirect("/404", 302);
const { row } = data;
---

<Base
  title={row.name_public}
  description="Fiche institutionnelle et rattachements officiels de cette administration."
>
  <DocumentContent>
    <header class="page-head">
      <div class="container">
        <Breadcrumbs
          items={[{ label: "Administrations", href: "/administrations" }, { label: "Structure" }]}
        />
        <div class="entity">
          <Icon name="administration" />
          <h1>{row.name_public}</h1>
        </div>
        <Answer text={`${row.category}${row.acronym ? ` · ${row.acronym}` : ""}.`} />
        {row.head_name && (
          <p>
            <Icon name="state" size={18} /> {row.head_name} · {row.head_role}
          </p>
        )}
        {row.head_name && (
          <p>
            <a
              href={
                row.head_role === "Président de la République"
                  ? "/train-de-vie#institutions"
                  : "/train-de-vie#cabinets"
              }
            >
              <Icon name="spending" size={15} />
              {row.head_role === "Président de la République"
                ? "Les comptes de la Présidence"
                : "Les moyens des cabinets ministériels"}
            </a>
          </p>
        )}
        {row.siren && <p>SIREN : {row.siren}</p>}
        <Provenance provenance={data.provenance}>
          {row.record_url && (
            <p>
              <a href={row.record_url}>Fiche officielle de cette structure</a>
            </p>
          )}
          {row.source_modified_at && <p>Modifiée le {formatDate(row.source_modified_at)}.</p>}
          <p>Cette fiche ne décrit ni un budget propre ni la compétence géographique du service.</p>
        </Provenance>
      </div>
    </header>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <Icon name="layers" />
            Les rattachements
          </h2>
        </div>
        {data.parents.length ? (
          <ul class="document-results">
            {data.parents.map((parent) => (
              <li>
                <a href={`/administrations/${parent.id}`}>{parent.name_public}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Aucun rattachement présent dans les sources intégrées.</p>
        )}
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <Icon name="administration" />
            Les services rattachés
          </h2>
        </div>
        {data.children.length ? (
          <ul class="document-results">
            {data.children.map((child) => (
              <li>
                <a href={`/administrations/${child.id}`}>{child.name_public}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Aucun service rattaché présent dans les sources intégrées.</p>
        )}
        {data.coverage.length > 0 && (
          <details>
            <summary>
              {formatNumber(data.coverage.length)} communes de la compétence préfectorale
            </summary>
            <ul>
              {data.coverage.map((commune) => (
                <li>
                  <a href={`/commune/${commune.insee}`}>{commune.name}</a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </section>
  </DocumentContent>
</Base>
