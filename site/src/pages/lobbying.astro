---
import Answer from "../components/Answer.astro";
import BarList from "../components/BarList.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ColumnChart from "../components/ColumnChart.astro";
import EuropeanLobbyingTable from "../components/EuropeanLobbyingTable.astro";
import Explainer from "../components/Explainer.astro";
import Icon from "../components/Icon.astro";
import KeyFigures from "../components/KeyFigures.astro";
import Provenance from "../components/Provenance.astro";
import Term from "../components/Term.astro";
import Toc from "../components/Toc.astro";
import Base from "../layouts/Base.astro";
import { getLobbying } from "../lib/data";
import { exercisePeriod } from "../lib/democracy";
import { formatDate, formatEuros, formatNumber } from "../lib/format";
const query = (Astro.url.searchParams.get("organisation") ?? "").slice(0, 100);
const data = await getLobbying(query);
const sections = [
  { href: "#institutions", label: "Institutions", icon: "state" as const },
  { href: "#organisations", label: "Organisations", icon: "building" as const },
  { href: "#publications", label: "Trimestres", icon: "calendar" as const },
  { href: "#budgets", label: "Budgets", icon: "euro" as const },
  { href: "#defauts", label: "Défauts", icon: "info" as const },
  { href: "#croisements", label: "Argent public", icon: "compare" as const },
  { href: "#europe", label: "Registre UE", icon: "europe" as const },
];
const bars = (rows: { label: string; count: number }[]) =>
  rows.map((r) => ({
    label: r.label,
    value: r.count,
    display: formatNumber(r.count),
    icon: "state" as const,
  }));
---

<Base
  title="Lobbying et argent public"
  description="Organisations inscrites aux registres HATVP et UE, activités déclarées et rapprochements avec l’argent public."
>
  <header class="page-head">
    <div class="container">
      <Breadcrumbs items={[{ label: "Lobbying" }]} />
      <div class="entity">
        <Icon name="lobbying" />
        <h1>Lobbying et argent public</h1>
      </div>
      <Answer
        text={`${formatNumber(data.totals.activities)} fiches de lobbying publiées à la HATVP en 12 mois.`}
      />
      <KeyFigures
        figures={[
          {
            icon: "building",
            label: "Organisations HATVP",
            value: formatNumber(data.totals.organisations),
            note: "Radiées incluses",
          },
          {
            icon: "lobbying",
            label: "Fiches publiées",
            value: formatNumber(data.totals.activities),
            note: "Sur 12 mois",
            term: "lobbying",
          },
          {
            icon: "info",
            label: "En défaut de déclaration",
            value: formatNumber(data.totals.defaults),
            note: "Liste officielle HATVP",
          },
          {
            icon: "europe",
            label: "Organisations françaises UE",
            value: formatNumber(data.totals.european),
            note: "Siège en France",
          },
        ]}
      />
      <Provenance
        provenance={[data.provenance, data.defaultsProvenance, data.europeanProvenance]}
      />
    </div>
  </header>
  <Toc items={sections} />
  <div class="container">
    <section class="section" id="institutions">
      <div class="section-head">
        <h2>
          <Icon name="state" /> Les institutions ciblées
        </h2>
        <p>Sur les 12 derniers mois.</p>
      </div>
      <div class="grid two">
        <div class="card">
          <BarList caption="Catégories d’institutions" items={bars(data.targets)} />
        </div>
        <div class="card">
          <BarList caption="Principaux ministères" items={bars(data.ministries)} />
        </div>
      </div>
      <Provenance provenance={data.provenance}>
        <p>Une fiche peut viser plusieurs institutions.</p>
      </Provenance>
    </section>
    <section class="section" id="organisations">
      <div class="section-head">
        <h2>
          <Icon name="building" /> Les organisations qui publient le plus
        </h2>
      </div>
      <form method="get" class="search-form">
        <label for="organisation">Rechercher une organisation</label>
        <div class="search-controls">
          <input
            id="organisation"
            name="organisation"
            value={query}
            maxlength="100"
            type="search"
          />
          <button class="button" type="submit">
            Rechercher
          </button>
        </div>
      </form>
      <div class="card">
        <table class="organisations">
          <thead>
            <tr>
              <th scope="col">Organisation</th>
              <th scope="col">Fiches</th>
              <th scope="col">Dépenses déclarées</th>
            </tr>
          </thead>
          <tbody>
            {data.organisations.map((row) => (
              <tr>
                <td>
                  {row.siren ? <a href={`/organisation/${row.siren}`}>{row.name}</a> : row.name}
                  <a class="small block" href={row.provenance.citations[0]!.recordUrl!}>
                    <Icon name="source" size={13} /> Fiche HATVP
                  </a>
                </td>
                <td class="num">{formatNumber(row.activities)}</td>
                <td>
                  {row.budget_label ?? "Non déclarées"}
                  <span class="small muted block">
                    {exercisePeriod(row.starts_on, row.ends_on)}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {data.organisations.length === 0 && <p>Aucun résultat pour cette recherche.</p>}
      </div>
      <Provenance provenance={data.provenance} />
    </section>
    <section class="section" id="publications">
      <div class="section-head">
        <h2>
          <Icon name="calendar" /> Les publications par trimestre
        </h2>
      </div>
      <div class="card">
        <ColumnChart
          caption="Fiches publiées par trimestre"
          unit="Fiches"
          columns={data.quarters.map((row) => ({
            label: `T${row.quarter} ${row.year}`,
            value: row.activities,
            display: formatNumber(row.activities),
            detail: `${formatNumber(row.activities)} fiches publiées`,
          }))}
        />
      </div>
      <Explainer title="Ces dates ne sont pas celles des actions">
        <p>
          Les activités sont déclarées par exercice, le plus souvent annuel. Le dépôt du printemps
          concerne généralement l’année précédente. Les dates de publication ne permettent pas de
          mesurer les actions réalisées dans un trimestre ni dans les 12 derniers mois. Le trimestre
          en cours est arrêté au {formatDate(data.asOf)}.
        </p>
      </Explainer>
      <Provenance provenance={data.provenance} />
    </section>
    <section class="section" id="budgets">
      <div class="section-head">
        <h2>
          <Icon name="euro" /> Les fourchettes de dépenses
        </h2>
        <p>Dernier exercice déclaré, années variables.</p>
      </div>
      <div class="card">
        <BarList
          caption="Organisations par fourchette de dépenses"
          items={data.budgets.map((r) => ({
            label: r.label,
            value: r.count,
            display: formatNumber(r.count),
            icon: "euro",
          }))}
        />
      </div>
      <Provenance provenance={data.provenance}>
        <p>Les fourchettes déclarées ne sont pas des montants exacts et ne s’additionnent pas.</p>
      </Provenance>
    </section>
    <section class="section" id="defauts">
      <div class="section-head">
        <h2>
          <Icon name="info" /> Les défauts de déclaration publiés par la HATVP
        </h2>
      </div>
      <div class="card">
        <details>
          <summary>
            Voir les {formatNumber(data.defaults.length)} organisations
            {query && " pour cette recherche"}
          </summary>
          <ul class="defaults">
            {data.defaults.map((r) => (
              <li>
                <strong>{r.name}</strong>
                <span class="small block">
                  {r.period} · {r.missing}
                </span>
              </li>
            ))}
          </ul>
        </details>
      </div>
      <Provenance provenance={data.defaultsProvenance}>
        <p>
          Un défaut de déclaration n’est pas une condamnation.{" "}
          <a href={data.defaultsUrl}>Liste officielle à jour</a>.
        </p>
      </Provenance>
    </section>
    <section class="section" id="croisements">
      <div class="section-head">
        <h2>
          <Icon name="compare" /> Des organisations présentes dans plusieurs jeux de données
        </h2>
      </div>
      <div class="card">
        <table class="crosses">
          <thead>
            <tr>
              <th scope="col">Organisation</th>
              <th scope="col">Marchés depuis 2019</th>
              <th scope="col">Versements de l’État 2025</th>
            </tr>
          </thead>
          <tbody>
            {data.crosses.map((r) => (
              <tr>
                <td>
                  <a href={`/organisation/${r.siren}`}>{r.name}</a>
                </td>
                <td>
                  {formatNumber(r.contracts)}
                  <span class="small muted block">{formatEuros(r.contract_amount)}</span>
                </td>
                <td>
                  {formatNumber(r.payments)}
                  <span class="small muted block">{formatEuros(r.payment_amount)}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Explainer title="Comment lire ces montants">
        <p>
          Les marchés sont des montants contractuels, pas des sommes payées. Les versements aux
          associations incluent subventions et prestations. Les périodes ne coïncident pas avec
          celles des déclarations de <Term id="lobbying">représentation d’intérêts</Term>.
        </p>
      </Explainer>
      <Provenance provenance={data.crossProvenance}>
        <p>
          {formatNumber(data.totals.crossrefs)} organisations figurent dans plusieurs jeux de
          données. Cela ne prouve aucun lien entre eux.
        </p>
      </Provenance>
    </section>
    <section class="section" id="europe">
      <div class="section-head">
        <h2>
          <Icon name="europe" /> Le registre de transparence de l’Union européenne
        </h2>
        <p>Organisations ayant leur siège en France.</p>
      </div>
      <div class="card">
        <BarList caption="Principaux domaines d’intérêt" items={bars(data.areas)} />
      </div>
      <div class="card">
        <h3>
          <Icon name="euro" /> Coûts annuels déclarés
        </h3>
        <EuropeanLobbyingTable rows={data.european} />
        {data.european.length === 0 && <p>Aucun résultat pour cette recherche.</p>}
      </div>
      <Provenance provenance={data.europeanProvenance}>
        <p>Les registres HATVP et UE n’ont pas le même périmètre.</p>
        <p>
          Les coûts sont souvent déclarés en fourchettes. Le classement suit la borne basse : il ne
          compare pas des dépenses exactes.
        </p>
      </Provenance>
    </section>
  </div>
</Base>
<style>
  #publications :global(.labels span) {
    white-space: normal;
  }
  .block {
    display: block;
  }
  table {
    table-layout: fixed;
  }
  td {
    overflow-wrap: anywhere;
    vertical-align: top;
  }
  .organisations th:first-child,
  .crosses th:first-child {
    width: 45%;
  }
  .organisations th:nth-child(2) {
    width: 15%;
  }
  .search-form {
    margin-bottom: 1rem;
  }
  .search-form label {
    display: block;
    margin-bottom: 0.5rem;
  }
  .search-controls {
    display: flex;
    gap: 0.5rem;
  }
  input {
    min-width: 0;
    flex: 1;
  }
  .defaults li {
    margin-bottom: 0.75rem;
    overflow-wrap: anywhere;
  }
  .card + .card {
    margin-top: 1rem;
  }
  @media (max-width: 500px) {
    .search-controls {
      flex-wrap: wrap;
    }
    th,
    td {
      padding: 0.75rem 0.4rem;
    }
  }
</style>
