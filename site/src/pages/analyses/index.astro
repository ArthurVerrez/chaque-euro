---
import "../../styles/journal.css";
import ArchiveStory from "../../components/ArchiveStory.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import Provenance from "../../components/Provenance.astro";
import Base from "../../layouts/Base.astro";
import { ANALYSES, ANALYSIS_TOPICS, analysis } from "../../lib/analyses";
import { getNantesAnalysis } from "../../lib/data";
import { formatDate, formatEuro, formatMillions } from "../../lib/format";

const selected = ANALYSIS_TOPICS.find(
  (topic) => topic.slug === Astro.url.searchParams.get("theme"),
);
const lead = analysis("nantes");
const data = selected
  ? null
  : await getNantesAnalysis().catch((error: unknown) => {
      console.error("Comptes nantais indisponibles pour la une des analyses", error);
      return null;
    });
const amount = data?.amounts.find((row) => row.year === 2025 && row.item === "depenses");
const personnel = data?.amounts.find((row) => row.year === 2025 && row.item === "personnel");
const gross = amount && (amount.metro + amount.municipalities) / amount.population;
const articles = ANALYSES.filter((article) => !selected || selected.articles.includes(article.slug))
  .map((article) => ({
    article,
    featured: article.slug === "marseille" || article.slug === "lille",
  }))
  .sort(
    (a, b) =>
      Number(b.featured) - Number(a.featured) ||
      (b.article.updated ?? b.article.published).localeCompare(
        a.article.updated ?? a.article.published,
      ),
  );
---

<Base
  title="Analyses"
  description="Les enquêtes de Chaque Euro sur les finances publiques, des communes à l’Europe. Explorez les chiffres et remontez à leurs sources."
>
  <div class="journal editorial">
    <div class="container">
      <header>
        <Breadcrumbs items={[{ label: "Analyses" }]} />
        <div class="masthead">
          <h1>Analyses</h1>
          <p>
            <Icon name="analysis" size={23} /> Les enquêtes de Chaque Euro sur les finances
            publiques, des communes à l’Europe.
          </p>
        </div>
      </header>

      {!selected && (
        <article class="lead-story" aria-labelledby="lead-title">
          <a class="lead-link" href={`/analyses/${lead.slug}`} aria-labelledby="lead-title">
            <img
              class="lead-art"
              src="/images/analyses/nantes.webp"
              width="1100"
              height="734"
              alt=""
              fetchpriority="high"
            />
            <div class="lead-copy">
              <div class="dateline">
                <span>
                  <Icon name="analysis" size={15} /> À la une
                </span>
                <time datetime={lead.published}>{formatDate(lead.published)}</time>
              </div>
              <h2 id="lead-title">
                À Nantes, comment compter chaque dépense une seule fois&nbsp;?
              </h2>
              <p>
                {amount && personnel
                  ? `En ${amount.year}, la métropole et ses communes se sont versé ${formatMillions(amount.transfers)}, dont ${formatMillions(personnel.transfers)} de frais de personnel.`
                  : lead.summary}
              </p>
              <span class="read">
                Lire l’analyse <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
          {data && amount && gross !== undefined && (
            <div class="ledger">
              <figure>
                <figcaption>
                  <span>
                    <Icon name="bars" size={16} /> Dépenses par habitant
                  </span>
                  Nantes Métropole et ses 24 communes en {amount.year}, hors remboursement du
                  capital des emprunts.
                </figcaption>
                <dl class="bars">
                  <div class="bar">
                    <dt>Budgets additionnés</dt>
                    <dd>{formatEuro(gross)}</dd>
                  </div>
                  <div class="bar" style={`--length: ${(amount.perCapita / gross) * 100}%`}>
                    <dt>Après retrait des transferts</dt>
                    <dd>{formatEuro(amount.perCapita)}</dd>
                  </div>
                </dl>
              </figure>
              <Provenance provenance={data.provenance} />
            </div>
          )}
        </article>
      )}

      <section class="archive" id="articles" aria-labelledby="archive-title">
        <div class="archive-head">
          <h2 id="archive-title">
            <span>
              <Icon name="book" size={21} />
            </span>
            Les articles
          </h2>
          <nav class="topics" aria-label="Filtrer par sujet">
            <a href="/analyses#articles" aria-current={!selected ? "true" : undefined}>
              Tout
            </a>
            {ANALYSIS_TOPICS.map((topic) => (
              <a
                href={`/analyses?theme=${topic.slug}#articles`}
                aria-current={selected === topic ? "true" : undefined}
              >
                {topic.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="stories">
          {articles.map((entry) => (
            <ArchiveStory {...entry} />
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .journal {
    min-height: 100%;
    padding: 0.45rem 0 clamp(3rem, 6vw, 6rem);
    background: var(--paper);
    color: var(--ink);
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.6rem 0 1.35rem;
    border-bottom: 4px double var(--ink);
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font: 400 clamp(4.4rem, 2.4rem + 5.2vw, 7.25rem) / 0.94 var(--display);
    letter-spacing: -0.045em;
  }

  .masthead p {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 19rem;
    margin: 0;
    color: var(--subtle);
    font-size: 0.925rem;
    line-height: 1.45;
  }

  .masthead p :global(svg) {
    flex: none;
    color: var(--red);
  }

  .lead-story {
    margin-top: 1.35rem;
  }

  .lead-link {
    display: grid;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .lead-art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.8;
    object-fit: cover;
    object-position: 35% center;
  }

  .lead-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.25rem, 3vw, 3rem);
  }

  .dateline,
  .dateline span,
  .read,
  figcaption span {
    display: flex;
    align-items: center;
  }

  .dateline {
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    color: #d7dedc;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .dateline span {
    gap: 0.4rem;
    color: #ffc197;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lead-copy h2 {
    margin: 0.9rem 0 0.65rem;
    color: var(--paper);
    font: 400 clamp(2.45rem, 1.65rem + 2.1vw, 4rem) / 1.02 var(--display);
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .lead-copy p {
    margin: 0;
    max-width: 45ch;
    color: #e1e7e2;
    font-size: 1rem;
    line-height: 1.55;
  }

  .read {
    gap: 0.8rem;
    margin-top: 1.25rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid #afbcba;
    font-size: 0.875rem;
    font-weight: 650;
  }

  .lead-link:is(:hover, :focus-visible) .read {
    border-color: #ffc197;
    color: #ffc197;
  }

  .ledger {
    padding: 1.1rem clamp(1rem, 2vw, 1.65rem) 0.9rem;
    border: 1px solid var(--rule);
    border-top: 0;
    background: #f2eee2;
  }

  figure {
    display: grid;
    align-items: center;
    gap: 0.9rem 2rem;
    margin: 0;
  }

  figcaption {
    color: var(--subtle);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.55;
  }

  figcaption span {
    gap: 0.4rem;
    margin-bottom: 0.18rem;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .bars {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 0.45rem;
    font-size: 0.8125rem;
    line-height: 1.25;
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .bar::after {
    content: "";
    grid-column: 1 / -1;
    height: 0.34rem;
    background: linear-gradient(
      to right,
      var(--bar-color, var(--ink)) var(--length, 100%),
      #dbd7ca 0
    );
  }

  .bar + .bar {
    --bar-color: var(--red);
  }

  .archive {
    margin-top: clamp(2rem, 3.3vw, 3rem);
    scroll-margin-top: calc(var(--sticky-top) + 0.75rem);
  }

  .archive-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--ink);
  }

  .archive-head h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--ink);
    font: 400 clamp(2.15rem, 1.4rem + 1.5vw, 3rem) / 1 var(--display);
    letter-spacing: -0.025em;
  }

  .archive-head h2 span {
    display: inline-flex;
    color: var(--red);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .topics a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 2rem;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.2;
    text-decoration: none;
  }

  .topics a:hover {
    border-color: var(--ink);
  }

  .topics a[aria-current] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .stories {
    display: grid;
    gap: 0 1.75rem;
    padding-top: 1.25rem;
  }

  @media (min-width: 48rem) {
    .lead-link {
      grid-template-columns: 1.1fr 1fr;
    }

    .lead-art {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }

    figure {
      grid-template-columns: 1fr 1.15fr;
    }

    .stories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (pointer: coarse) {
    .topics a {
      min-height: 44px;
    }
  }
</style>
